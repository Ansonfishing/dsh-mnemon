{
  "name": "dsh-mnemon",
  "version": "0.1.0",
  "description": "LLM-supervised persistent memory for DeepSeek Harness, powered by Mnemon with native tools, commands, settings, and WebUI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "mnemon",
    "agent-memory",
    "persistent-memory",
    "llm-memory",
    "knowledge-graph",
    "ai-agent",
    "llm-agent",
    "external-memory",
    "local-first",
    "llm-supervised",
    "sqlite",
    "typescript",
    "cordis",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-external/dsh-mnemon.git"
  },
  "homepage": "https://github.com/dsh-external/dsh-mnemon#readme",
  "bugs": {
    "url": "https://github.com/dsh-external/dsh-mnemon/issues"
  },
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-config"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "prepublishOnly": "pnpm run verify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "cordis": "^4.0.0-rc.7",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
